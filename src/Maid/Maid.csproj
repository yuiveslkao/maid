<Project Sdk="Microsoft.NET.Sdk">
  <!-- maid.exe（ウィンドウ・部品の起動・セットアップ）。Windows Forms は UseWindowsForms ではなく FrameworkReference で使う
       （Linux の .NET SDK でもビルドできるように） -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Maid</RootNamespace>
    <AssemblyName>maid</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- ネイティブの DLL は %TEMP% に展開させず、maid フォルダの lib\ に置く（NativeLibraries.cs が lib\ から読む） -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WebView2 の WPF 用の部品（maid は使わない）の参照の食い違いの警告は出さない -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <ProjectReference Include="..\Maid.Core\Maid.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ui\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
